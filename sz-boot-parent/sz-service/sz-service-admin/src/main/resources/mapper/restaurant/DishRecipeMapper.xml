<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.admin.restaurant.mapper.DishRecipeMapper">

    <resultMap id="dishRecipeVO" type="com.sz.admin.restaurant.pojo.vo.DishRecipeVO">
        <id property="id" column="id"/>
        <result property="dishId" column="dish_id"/>
        <result property="materialId" column="material_id"/>
        <result property="materialQuantity" column="material_quantity"/>
        <result property="materialName" column="material_name"/>
        <result property="unit" column="unit"/>
    </resultMap>

    <select id="selectListByDishId" resultMap="dishRecipeVO">
        SELECT 
            dr.id,
            dr.dish_id,
            dr.material_id,
            dr.material_quantity,
            i.material_name,
            i.unit
        FROM dish_recipe dr
        LEFT JOIN inventory i ON dr.material_id = i.material_id
        WHERE dr.dish_id = #{dishId}
    </select>

</mapper>
